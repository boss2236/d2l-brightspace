# Your institution's Brightspace host (check the URL when you're logged in)
D2L_BASE_URL=https://your-school.brightspace.com
# Optional: time zone for dates, e.g. Asia/Qatar (default: this computer's)
D2L_TZ=

# --- which enrolments count as this term's courses (optional) ---
# Default: a course has both a start and an end date, and today falls between them. Service pages usually have no
# dates. If yours do, narrow it with a code pattern, or list course ids (see `d2l courses --all`).
# D2L_COURSE_CODE_REGEX=^[A-Z]{3,5}_\d{4}_
# D2L_COURSES_INCLUDE=123456,234567
# D2L_COURSES_EXCLUDE=345678

# Label of the SSO button on your Brightspace login page (regex), if silent re-login can't find it
# D2L_SSO_BUTTON=Single Sign On

# --- notifications (all optional; desktop notify-send is on by default) ---
# D2L_NOTIFY_DESKTOP=0
# Telegram: create a bot with @BotFather, send it a message, chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
D2L_TELEGRAM_TOKEN=
D2L_TELEGRAM_CHAT=
# Discord: channel settings -> Integrations -> Webhooks -> copy URL
D2L_DISCORD_WEBHOOK=
# Any URL that should receive each sync's changes as JSON (n8n webhook, custom app, WhatsApp bridge)
D2L_WEBHOOK_URL=

# --- text recognition for scanned PDFs (needs tesseract + poppler's pdftoppm; skipped if missing) ---
# D2L_OCR=0                 # turn it off
# D2L_OCR_LANG=eng          # tesseract languages, e.g. eng+ara
# D2L_OCR_MAX_PAGES=40

# --- Semestra (optional): push courses and grades after each sync; set these in the app's Connect AI tab ---
# SEMESTRA_URL=https://<project>.supabase.co/functions/v1/connector-ingest
# SEMESTRA_KEY=

# If you run a modified copy for other people, point this at your source code (AGPL-3.0 §13)
# D2L_SOURCE_URL=https://github.com/<you>/<your-fork>

# --- `d2l serve` (MCP over HTTP + REST) ---
# Bearer token; generated here automatically on the first `d2l serve`
# D2L_API_TOKEN=
# Extra hostnames to accept, e.g. a cloudflared/tailscale tunnel: D2L_PUBLIC_HOSTS=abc.trycloudflare.com
D2L_PUBLIC_HOSTS=
