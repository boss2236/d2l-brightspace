# Your institution's Brightspace host (check the URL when you're logged in)
D2L_BASE_URL=https://your-school.brightspace.com
# Optional: time zone Brightspace shows dates in (default Asia/Qatar)
D2L_TZ=

# --- notifications (all optional; desktop notify-send is on by default) ---
# D2L_NOTIFY_DESKTOP=0
# Telegram: create a bot with @BotFather, send it a message, chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
D2L_TELEGRAM_TOKEN=
D2L_TELEGRAM_CHAT=
# Discord: channel settings -> Integrations -> Webhooks -> copy URL
D2L_DISCORD_WEBHOOK=
# Any URL that should receive each sync's changes as JSON (n8n webhook, custom app, WhatsApp bridge)
D2L_WEBHOOK_URL=

# --- `d2l serve` (MCP over HTTP + REST) ---
# Bearer token; generated here automatically on the first `d2l serve`
# D2L_API_TOKEN=
# Extra hostnames to accept, e.g. a cloudflared/tailscale tunnel: D2L_PUBLIC_HOSTS=abc.trycloudflare.com
D2L_PUBLIC_HOSTS=
